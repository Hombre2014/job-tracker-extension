{
  "manifest_version": 3,
  "name": "Job Tracker Helper",
  "version": "1.6.3",
  "description": "Extract job posts details like title, company, location, salary, and description in to your Job Tracker app.",
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "32": "images/icons/icon-32.png",
      "48": "images/icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "externally_connectable": {
    "matches": [
      "https://online-job-trackr.vercel.app/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "https://job-tracker-backend-five.vercel.app/*",
    "https://online-job-trackr.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://autocomplete.clearbit.com/*",
    "https://www.google.com/*",
    "https://*.gstatic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "https://online-job-trackr.vercel.app/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:3001/*"
      ],
      "js": ["src/content/index.ts"]
    }
  ],
  "icons": {
    "32": "images/icons/icon-32.png",
    "48": "images/icons/icon-48.png",
    "128": "images/icons/icon-128.png"
  }
}
