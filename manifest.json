{
  "manifest_version": 3,
  "name": "Job Tracker Extension",
  "version": "1.5.0",
  "description": "Scrape job details and save them to your Job Tracker.",
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "externally_connectable": {
    "matches": [
      "https://online-job-trackr.vercel.app/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "host_permissions": [
    "*://*.linkedin.com/*",
    "*://*.indeed.com/*",
    "https://job-tracker-backend-five.vercel.app/*",
    "https://online-job-trackr.vercel.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://autocomplete.clearbit.com/*",
    "https://www.google.com/*",
    "https://*.gstatic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*",
        "*://*.indeed.com/*",
        "https://online-job-trackr.vercel.app/*",
        "http://localhost:3000/*",
        "http://localhost:3001/*",
        "http://127.0.0.1:3000/*",
        "http://127.0.0.1:3001/*"
      ],
      "js": ["src/content/index.ts"]
    }
  ],
  "icons": {
    "16": "public/vite.svg",
    "48": "public/vite.svg",
    "128": "public/vite.svg"
  }
}
